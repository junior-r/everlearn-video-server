PORT=8080
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_change_me_32_chars_minimum
BACKEND_INTERNAL_URL=http://localhost:4000
INTERNAL_SERVICE_SECRET=change_me
REDIS_URL=redis://localhost:6379
# Frontend origin allowed to post chat messages from a browser
ALLOWED_ORIGIN=http://localhost:3000
# off (default), mock (placeholder captions, no external call) or deepgram (needs DEEPGRAM_API_KEY)
TRANSCRIPTION_PROVIDER=mock
TRANSCRIPTION_LANGUAGE=es
DEEPGRAM_API_KEY=
# true joins rooms as a hidden participant to hear real audio; false (default) never connects to a room
ENABLE_STT=false
